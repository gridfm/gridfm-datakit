#!/bin/bash

BASE="/dccstor/gridfm/powermodels_data/v4/texas_contingency/ercot_04_23_train"

grids=()
for d in "$BASE"/*/; do
    grids+=("$(basename "$d")")
done

source /u/apu/gridfm-datakit/venv/bin/activate

total=${#grids[@]}
with_raw=0
for g in "${grids[@]}"; do
    [[ -d "$BASE/$g/raw" ]] && ((with_raw++))
done

echo "📊 Pre-run summary:"
echo "  - Total grids found : $total"
echo "  - With raw/         : $with_raw"
echo "  - Will be skipped   : $((total - with_raw))"
echo

attempted=0
validated=0
skipped=0
failed=0
already_validated=0

for g in "${grids[@]}"; do
    if [[ ! -d "$BASE/$g/raw" ]]; then
        echo "⚠️  Skipping $g (no raw/ directory)"
        ((skipped++))
        continue
    fi

    if [[ -f "$BASE/$g/raw/0_VALIDATION_OK" ]]; then
        echo "ℹ️  Skipping $g (already validated)"
        ((already_validated++))
        continue
    fi

    ((attempted++))

    if ! gridfm_datakit validate "$BASE/$g/raw" --n-partitions 20 --mode pf; then
        echo "❌ Validation failed for $g"
        ((failed++))
        continue
    fi

    echo "✅ Validation OK for $g"
    touch "$BASE/$g/raw/0_VALIDATION_OK"
    ((validated++))
done

echo
echo "📊 Post-run summary:"
echo "  - Attempted        : $attempted"
echo "  - Already validated: $already_validated"
echo "  - Validated        : $validated"
echo "  - Failed           : $failed"
echo "  - Skipped (no raw) : $skipped"

if [[ $failed -ne 0 ]]; then
    echo "❌ Script terminated with failures (exit code 1)"
    exit 1
fi

touch "$BASE/0_VALIDATION_OK"
echo "✅ All validations successful"
